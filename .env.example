# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TMDB_API_KEY: Required for live movie data, posters, credits, and watch providers from TMDB.
# Supports either a TMDB v3 API Key or a TMDB v4 Read Access Token.
TMDB_API_KEY="MY_TMDB_API_KEY"

# AUTH_SECRET: Optional secret key for signing user session tokens.
AUTH_SECRET="CHANGE_ME_SESSION_SECRET"

# MODERATOR_PASSCODE: Optional passcode for accessing the Moderator Console.
# If left unset, you can claim the first moderator account directly in the Moderator Portal UI.
MODERATOR_PASSCODE=""
